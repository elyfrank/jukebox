{
  "expo": {
    "name": "JukeBox",
    "slug": "jukebox",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./public/images/ios/AppIcon-1024.png",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./public/images/ios/AppIcon-1024.png",
        "dark": "./public/images/ios/AppIcon-1024-escuro.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/images/android/adaptive-foreground-1024.png",
        "monochromeImage": "./public/images/android/adaptive-monochrome-1024.png",
        "backgroundColor": "#6D28D9"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jukebox.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O $(PRODUCT_NAME) usa a câmera para escanear o QR code da festa.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./public/images/tela-abertura/logo-claro.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5FB",
          "dark": {
            "image": "./public/images/tela-abertura/logo-escuro.png",
            "backgroundColor": "#121019"
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "jukebox",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aa4d0bba-f8ee-4bb0-8185-8f4f9a32d9d8"
      }
    },
    "owner": "elyfrank",
    "web": {
      "favicon": "./public/images/web/favicon-48.png"
    }
  }
}
